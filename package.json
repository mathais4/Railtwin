{
  "name": "railtwin",
  "version": "0.1.0",
  "description": "Railway disruption simulator: discrete-event simulation of trains, platforms and connections, with response comparison, optimisation and replay scoring.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build:web && tsx src/api/server.ts",
    "dev": "tsx watch src/api/server.ts",
    "build:web": "tsx scripts/build-web.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/run.ts",
    "replay": "tsx scripts/replay-report.ts",
    "gen:observed": "tsx scripts/generate-observed.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
